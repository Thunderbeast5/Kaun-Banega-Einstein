rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Schools ──────────────────────────────────────────────────────────────
    match /schools/{udiseNumber} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.udiseNumber == udiseNumber;

      // School's own coordinator OR an admin can update
      allow update: if request.auth != null && (
        resource.data.authUid == request.auth.uid
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      allow delete: if request.auth != null
        && resource.data.authUid == request.auth.uid;
    }

    // ── Students ─────────────────────────────────────────────────────────────
    // Path: students/{udise}/roster/{applicationNumber}
    //
    // The school document at schools/{udise} holds authUid.
    // A teacher can only register students under their own school's UDISE.
    match /students/{udise} {
      // Allow reads on the school-level document (e.g. metadata)
      allow read: if request.auth != null;

      match /roster/{applicationNumber} {
        // Any authenticated user can read student records (hall tickets, view students)
        allow read: if request.auth != null;

        // Only the school that owns this UDISE can create/update/delete students
        allow write: if request.auth != null
          && exists(/databases/$(database)/documents/schools/$(udise))
          && get(/databases/$(database)/documents/schools/$(udise)).data.authUid == request.auth.uid;
      }
    }

    // ── Admins ───────────────────────────────────────────────────────────────
    // A signed-in user may only read their own admin document to verify access.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    // Anyone can read platform settings (Navbar and Registration page read this while unauthenticated).
    // Only admins can update the settings.
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

  }
}
